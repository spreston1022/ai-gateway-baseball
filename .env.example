# Environment variables for local development.
#
# Copy this file to .env and replace the sample values. `zuplo dev` loads .env
# automatically. .env is gitignored, so real secrets stay out of source control.
#
# Reference a variable from config files as $env(EXAMPLE_API_KEY), or from code
# as `environment.EXAMPLE_API_KEY` (import `environment` from "@zuplo/runtime").
#
# For deployed environments, set variables in the Zuplo Portal under
# Settings > Environment Variables. Docs:
# https://zuplo.com/docs/articles/environment-variables
EXAMPLE_API_KEY=replace-me

# Used by generic-jwt-auth-inbound (OpenIdJwtInboundPolicy) to verify the JWT
# the baseball Worker signs per end user. The Worker is the issuer, not this
# gateway, so these must NOT point back at this gateway's own domain — a
# deployed gateway can't fetch() back to its own zone, so jwkUrl would always
# time out. Set these in the Zuplo Portal under Settings > Environment
# Variables for deployed environments.
JWT_ISSUER=https://baseball-chatbot.spreston1022.workers.dev
JWT_AUDIENCE=baseball-ai-gateway
JWT_JWKS_URL=https://baseball-chatbot.spreston1022.workers.dev/.well-known/jwks.json
